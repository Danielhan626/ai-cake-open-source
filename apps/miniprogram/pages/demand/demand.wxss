.demand-copy {
  display: block;
  margin-top: 18rpx;
}

.credential-line {
  display: block;
  margin-top: 18rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quote-form .textarea {
  min-height: 150rpx;
}

.small-textarea {
  min-height: 110rpx;
}

.demand-form {
  display: grid;
  gap: 18rpx;
}

.demand-field-stack {
  display: grid;
  gap: 18rpx;
}

.demand-loop {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}

.demand-loop text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #2f6f5f;
  background: #edf8f2;
  text-align: center;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1.15;
}

.demand-status-loop {
  margin-top: 18rpx;
}

.demand-next,
.quote-guidance {
  display: grid;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f4fbf6;
}

.production-notice-card,
.production-confirm-summary {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff7f3;
}

.same-style-title {
  display: block;
  color: #302923;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.confirm-state {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b94e58;
  background: #fff0ec;
  font-size: 22rpx;
  font-weight: 900;
}

.confirm-state.active {
  color: #2f6f5f;
  background: #edf8f2;
}

.production-notice-list {
  display: grid;
  gap: 10rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #fffefb;
}

.production-notice-list text,
.production-confirm-summary text {
  display: block;
  color: #6b5147;
  font-size: 23rpx;
  line-height: 1.45;
}

.production-confirm-title {
  color: #2f6f5f !important;
  font-weight: 900;
}

.confirm-notice-button {
  margin: 0;
}

.demand-next-title,
.form-step-title {
  display: block;
  color: #2f6f5f;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
}

.demand-summary,
.quote-entry-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.demand-summary-item,
.quote-entry-item {
  min-width: 0;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #fff7f3;
}

.demand-summary-item text:first-child,
.quote-entry-item text:first-child {
  display: block;
  color: #8a7466;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.2;
}

.demand-summary-item text:last-child,
.quote-entry-item text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #302923;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow-wrap: break-word;
}

.form-summary {
  margin-top: 0;
}

.form-step-title {
  margin-top: 4rpx;
}

.detail-toggle {
  min-height: 72rpx;
  margin: 0;
  font-size: 26rpx;
  box-shadow: none;
}

.detail-fields {
  display: grid;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fffaf5;
}

.actions {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.two-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.two-actions button {
  min-height: 78rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 25rpx;
}

.demand-loop text.active {
  color: #ffffff;
  background: #2f6f5f;
}

.trust-list {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff7f3;
}

.trust-list text {
  display: block;
  color: #6b5147;
  font-size: 24rpx;
  line-height: 1.4;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 16rpx;
  color: #4b4139;
  background: #fffefb;
  font-size: 27rpx;
}

.switch-pill {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b94e58;
  background: #fff0ec;
  font-size: 24rpx;
  font-weight: 900;
}

.switch-pill.active {
  color: #2f6f5f;
  background: #edf8f2;
}

.quote-focus {
  border-color: rgba(47, 124, 103, 0.24);
  box-shadow: 0 16rpx 36rpx rgba(47, 124, 103, 0.08);
}

.quote-entry-note {
  display: block;
  color: #2f6f5f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.quote-entry-summary {
  margin-top: 18rpx;
}

.quote-guidance {
  margin-bottom: 6rpx;
  background: #fff7f3;
}

.quote-guidance text {
  color: #6b5147;
  font-size: 23rpx;
  line-height: 1.4;
}

.quote-certainty-grid {
  margin-top: 4rpx;
}

.quote-action,
.empty-action {
  margin-top: 22rpx;
}

.demand-copy {
  color: #6f6158;
}

.credential-line {
  color: #2f6f5f;
}
