.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 18rpx;
}

.refresh-button {
  width: 160rpx;
  min-width: 0;
  min-height: 68rpx;
  font-size: 26rpx;
}

.compact-tags {
  margin-top: 12rpx;
}

.desk-button {
  margin-top: 22rpx;
  min-height: 76rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.2;
}

.baker-flow {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.baker-flow text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #2f6f5f;
  background: #edf8f2;
  text-align: center;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1.15;
}

.market-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.market-summary-item {
  min-width: 0;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  background: #fff7f3;
  text-align: center;
}

.market-summary-item text:first-child {
  display: block;
  color: #8a7466;
  font-size: 20rpx;
  line-height: 1.2;
}

.market-summary-item text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #302923;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.market-trust {
  display: block;
  margin-top: 14rpx;
  color: #6b5147;
  font-size: 23rpx;
  line-height: 1.45;
}

.demand-card {
  grid-template-columns: 136rpx minmax(0, 1fr);
  align-items: stretch;
  overflow: hidden;
}

.demand-body {
  display: grid;
  align-content: start;
  min-width: 0;
  gap: 8rpx;
}

.demand-brief {
  display: -webkit-box;
  overflow: hidden;
  color: #6f6158;
  font-size: 24rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.demand-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  gap: 10rpx;
  margin-top: 8rpx;
}

.mini-demand-button {
  min-height: 62rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.2;
  box-shadow: none;
}

.quote-demand-button {
  color: #ffffff;
}

.disabled-demand-button {
  color: #8a8179;
  background: #f4f0eb;
  box-shadow: none;
}

.baker-card {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fffdf9;
}

.market-empty {
  display: grid;
  gap: 16rpx;
  padding: 18rpx 0 6rpx;
}

.market-empty-title {
  color: #302923;
  font-size: 30rpx;
  font-weight: 900;
}

.cert-line {
  display: block;
  margin-top: 14rpx;
}

.empty-action {
  margin-top: 22rpx;
}
