.works-page {
  padding-bottom: 42rpx;
}

.forum-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 156rpx;
  box-sizing: border-box;
  max-width: 100%;
  gap: 18rpx;
  align-items: center;
  padding: 32rpx 28rpx 28rpx;
  border: 1rpx solid rgba(117, 81, 63, 0.12);
  border-radius: 28rpx;
  color: #302923;
  background:
    radial-gradient(circle at 18% 2%, rgba(204, 93, 102, 0.12), transparent 30%),
    linear-gradient(135deg, #fffefb 0%, #fff2ec 52%, #eff9f2 100%);
  box-shadow: 0 20rpx 54rpx rgba(109, 69, 54, 0.12);
  margin-bottom: 24rpx;
}

.forum-hero .title,
.forum-hero .eyebrow {
  color: #302923;
}

.forum-hero .muted {
  display: block;
  margin-top: 14rpx;
  color: #6f6158;
}

.forum-hero-copy {
  min-width: 0;
}

.display-plate {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 168rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
}

.display-plate text {
  display: block;
  margin-top: 12rpx;
  color: #7d5d52;
  font-size: 23rpx;
  font-weight: 860;
}

.plate-cake {
  width: 98rpx;
  height: 98rpx;
  border-radius: 50% 50% 44% 44%;
  background:
    radial-gradient(circle at 34% 28%, #ffffff 0 10rpx, transparent 11rpx),
    radial-gradient(circle at 66% 34%, #cc5d66 0 9rpx, transparent 10rpx),
    linear-gradient(180deg, #ffc1c8 0%, #fff7f0 48%, #9fd7be 100%);
  box-shadow: 0 14rpx 24rpx rgba(109, 69, 54, 0.12);
}

.forum-stats {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.forum-stat {
  min-height: 98rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.74);
  text-align: center;
}

.forum-stat text:first-child {
  display: block;
  color: #302923;
  font-size: 28rpx;
  font-weight: 900;
}

.forum-stat text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #7d6d62;
  font-size: 22rpx;
}

.header-row,
.work-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 18rpx;
}

.refresh-button {
  width: 150rpx;
  min-width: 0;
  min-height: 66rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 1.2;
}

.forum-label {
  flex: 0 0 auto;
  max-width: 210rpx;
  box-sizing: border-box;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #2f6f5f;
  background: #edf8f2;
  font-size: 24rpx;
  font-weight: 850;
}

.owned-label {
  color: #7a5346;
  background: #fff2ee;
}

.inspiration-label {
  color: #855f19;
  background: #fff6df;
}

.bot-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.bot-mini {
  min-height: 138rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(47, 124, 103, 0.1);
  border-radius: 18rpx;
  background: #f4fbf6;
}

.bot-name {
  display: block;
  color: #2f6f5f;
  font-size: 26rpx;
  font-weight: 900;
}

.bot-line {
  display: block;
  margin-top: 8rpx;
  color: #5f6964;
  font-size: 23rpx;
  line-height: 1.4;
}

.owned-scroll {
  width: 100%;
  margin-top: 8rpx;
  white-space: nowrap;
}

.owned-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 6rpx 2rpx 2rpx;
}

.owned-card {
  display: grid;
  grid-template-columns: 136rpx minmax(0, 1fr);
  min-width: 0;
  gap: 14rpx;
  width: 530rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(94, 73, 53, 0.08);
  border-radius: 20rpx;
  background: #fffefb;
  box-sizing: border-box;
}

.owned-open-button {
  width: 170rpx;
  min-width: 0;
  min-height: 58rpx;
  margin: 2rpx 0 0;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.2;
  box-shadow: none;
}

.owned-thumb {
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  background: #f4eee7;
}

.owned-body {
  display: grid;
  align-content: start;
  gap: 8rpx;
  min-width: 0;
}

.owned-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  gap: 10rpx;
}

.owned-head .card-title {
  min-width: 0;
}

.owned-pill {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.owned-pill.pending {
  color: #855f19;
  background: #fff6df;
}

.owned-pill.private {
  color: #7a5346;
  background: #fff2ee;
}

.owned-pill.rejected {
  color: #ffffff;
  background: #a9644f;
}

.compact-tags {
  margin-top: 12rpx;
}

.gallery-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0;
  border: 1rpx solid rgba(94, 73, 53, 0.1);
  border-radius: 22rpx;
  background: #fffefb;
}

.gallery-card .thumb,
.gallery-cover {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 0;
  background: #f4eee7;
}

.work-body {
  display: grid;
  align-content: start;
  gap: 8rpx;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  padding: 18rpx;
}

.work-title-row {
  align-items: flex-start;
  flex-wrap: wrap;
}

.work-title-row .card-title {
  min-width: 0;
  line-height: 1.3;
}

.heat-pill {
  flex: 0 0 auto;
  max-width: 160rpx;
  box-sizing: border-box;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #cc5d66;
  font-size: 22rpx;
  font-weight: 900;
}

.ai-review,
.maker-tip {
  display: grid;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 14rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: break-word;
  word-break: break-word;
}

.ai-review {
  color: #2f6f5f;
  background: #edf8f2;
  gap: 10rpx;
}

.maker-tip {
  color: #6b5147;
  background: #fff2ee;
}

.gallery-review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.gallery-review-name {
  display: block;
  color: #2f6f5f;
  font-size: 24rpx;
  font-weight: 900;
}

.gallery-review-focus {
  display: block;
  margin-top: 4rpx;
  color: #7a5346;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.gallery-review-tag {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #2f6f5f;
  background: rgba(255, 255, 255, 0.86);
  font-size: 20rpx;
  font-weight: 850;
}

.gallery-review-line {
  display: block;
  color: #2f6f5f;
  font-size: 24rpx;
  line-height: 1.45;
}

.card-loop {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  min-width: 0;
  gap: 8rpx;
}

.card-loop text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #2f6f5f;
  background: #edf8f2;
  text-align: center;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1.15;
}

.market-bridge {
  display: block;
  color: #75675e;
  font-size: 22rpx;
  line-height: 1.4;
}

.forum-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  max-width: 100%;
  gap: 12rpx;
  margin-top: 10rpx;
}

.mini-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 64rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #302923;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
  white-space: normal;
}

.gallery-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  min-width: 0;
  max-width: 100%;
  gap: 8rpx;
}

.gallery-metrics text {
  display: block;
  min-width: 0;
  padding: 8rpx 6rpx;
  border-radius: 12rpx;
  color: #6f6158;
  background: #fbf5ec;
  text-align: center;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow-wrap: break-word;
}

.rose-button {
  background: #cc5d66;
}

.detail-button {
  color: #2f6f5f;
  background: #edf8f2;
}

.adopt-mini-button {
  background: #2f7c67;
}

.empty-block {
  display: grid;
  gap: 14rpx;
  padding: 6rpx 0 4rpx;
}

.empty-title {
  color: #302923;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.empty-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  gap: 12rpx;
  margin-top: 4rpx;
}

.empty-action {
  margin-top: 0;
}

.ghost-empty-action {
  min-height: 82rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.2;
}

.inspiration-list {
  display: grid;
  gap: 14rpx;
}

.inspiration-card {
  display: grid;
  min-width: 0;
  max-width: 100%;
  width: 100%;
  min-height: 0;
  margin: 0;
  box-sizing: border-box;
  gap: 10rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(133, 95, 25, 0.08);
  border-radius: 18rpx;
  background: #fffdf7;
}

.inspiration-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  gap: 12rpx;
}

.inspiration-reward {
  flex: 0 0 auto;
  max-width: 180rpx;
  box-sizing: border-box;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #855f19;
  background: #fff2c7;
  font-size: 22rpx;
  font-weight: 900;
}

.inspiration-rule {
  display: block;
  color: #7a5346;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.inspiration-action {
  color: #2f6f5f;
  font-size: 25rpx;
  font-weight: 900;
}
