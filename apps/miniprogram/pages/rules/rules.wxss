.rules-page {
  padding-bottom: 42rpx;
}

.rules-hero {
  padding: 34rpx 28rpx 28rpx;
  border: 1rpx solid rgba(117, 81, 63, 0.12);
  border-radius: 28rpx;
  color: #302923;
  background:
    radial-gradient(circle at 86% 12%, rgba(159, 215, 190, 0.24), transparent 28%),
    linear-gradient(135deg, #fffefb 0%, #fff2ec 52%, #edf8f2 100%);
  box-shadow: 0 20rpx 54rpx rgba(109, 69, 54, 0.12);
  margin-bottom: 24rpx;
}

.rules-hero .title,
.rules-hero .eyebrow {
  color: #302923;
}

.rules-hero .muted {
  display: block;
  margin-top: 14rpx;
  color: #6f6158;
}

.rule-list {
  display: grid;
  gap: 14rpx;
}

.rule-row {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  color: #4b4139;
  font-size: 26rpx;
  line-height: 1.5;
}

.dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #2f6f5f;
}
