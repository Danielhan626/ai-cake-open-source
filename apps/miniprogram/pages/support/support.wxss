.support-page {
  padding-bottom: 42rpx;
}

.support-hero {
  padding: 34rpx 28rpx 28rpx;
  border: 1rpx solid rgba(117, 81, 63, 0.12);
  border-radius: 28rpx;
  color: #302923;
  background:
    radial-gradient(circle at 86% 12%, rgba(204, 93, 102, 0.18), transparent 28%),
    linear-gradient(135deg, #fffefb 0%, #fff2ec 52%, #edf8f2 100%);
  box-shadow: 0 20rpx 54rpx rgba(109, 69, 54, 0.12);
  margin-bottom: 24rpx;
}

.support-hero .title,
.support-hero .eyebrow {
  color: #302923;
}

.support-hero .muted {
  display: block;
  margin-top: 14rpx;
  color: #6f6158;
}

.submit-button {
  margin-top: 18rpx;
}

.ticket-list {
  display: grid;
  gap: 14rpx;
}

.ticket-card {
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fffefb;
}

.ticket-title {
  display: block;
  color: #302923;
  font-size: 29rpx;
  font-weight: 900;
}

.ticket-desc {
  display: block;
  margin-top: 10rpx;
  color: #5c655f;
  font-size: 25rpx;
  line-height: 1.45;
}
