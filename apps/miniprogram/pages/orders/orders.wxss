.orders-page {
  padding-bottom: 42rpx;
}

.order-hero {
  padding: 34rpx 28rpx 28rpx;
  border: 1rpx solid rgba(117, 81, 63, 0.12);
  border-radius: 28rpx;
  color: #302923;
  background:
    radial-gradient(circle at 86% 12%, rgba(159, 215, 190, 0.24), transparent 28%),
    linear-gradient(135deg, #fffefb 0%, #fff2ec 52%, #edf8f2 100%);
  box-shadow: 0 20rpx 54rpx rgba(109, 69, 54, 0.12);
  margin-bottom: 24rpx;
}

.order-hero .title,
.order-hero .eyebrow {
  color: #302923;
}

.order-hero .muted {
  display: block;
  margin-top: 14rpx;
  color: #6f6158;
}

.order-list-panel {
  gap: 16rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  width: 100%;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(94, 73, 53, 0.1);
  border-radius: 16rpx;
  background: #fffefb;
  text-align: left;
  line-height: 1.4;
}

.history-item::after {
  border: 0;
}

.history-item.active {
  border-color: #cc5d66;
  background: #fff2ee;
}

.history-title {
  display: block;
  max-width: 430rpx;
  color: #302923;
  font-size: 28rpx;
  font-weight: 700;
}

.history-price {
  flex: 0 0 auto;
  color: #cc5d66;
  font-size: 28rpx;
  font-weight: 800;
}

.order-head,
.section-head,
.order-meta,
.delivery-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-title {
  display: block;
  color: #302923;
  font-size: 34rpx;
  font-weight: 920;
  line-height: 1.25;
}

.status-pill,
.delivery-status {
  flex: 0 0 auto;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.status-pill {
  color: #ffffff;
  background: #cc5d66;
}

.delivery-status {
  color: #2f6f5f;
  background: #edf8f2;
}

.order-image {
  width: 100%;
  aspect-ratio: 1;
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #fffefb;
}

.next-step-panel {
  border-color: rgba(47, 124, 103, 0.18);
}

.next-step-title {
  display: block;
  margin-bottom: 10rpx;
  color: #2f6f5f;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.order-rules-panel {
  border-color: rgba(204, 93, 102, 0.16);
}

.order-rule-list {
  display: grid;
  gap: 10rpx;
}

.order-rule-card {
  display: grid;
  gap: 6rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #fff7f3;
}

.order-rule-title {
  color: #302923;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
}

.order-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.order-summary-item {
  min-width: 0;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f4fbf6;
}

.order-summary-item text:first-child {
  display: block;
  color: #6f8178;
  font-size: 21rpx;
  line-height: 1.2;
}

.order-summary-item text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #302923;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.25;
  overflow-wrap: break-word;
}

.order-meta {
  margin-top: 18rpx;
}

.order-meta view {
  flex: 1;
  min-height: 112rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fffefb;
}

.order-meta text:first-child {
  display: block;
  color: #8a7466;
  font-size: 24rpx;
}

.order-meta text:last-child {
  display: block;
  margin-top: 10rpx;
  color: #302923;
  font-size: 30rpx;
  font-weight: 900;
}

.step-list {
  display: grid;
  gap: 14rpx;
}

.order-step {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  color: #6b625b;
  background: #fffdf9;
  font-size: 27rpx;
  font-weight: 760;
}

.step-dot {
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #cfc6bc;
}

.order-step.done {
  color: #2f6f5f;
  background: #f4fbf6;
}

.order-step.done .step-dot {
  background: #2f6f5f;
}

.delivery-card {
  align-items: flex-start;
  justify-content: flex-start;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fffefb;
}

.courier-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #2f6f5f;
  font-size: 28rpx;
  font-weight: 900;
}

.courier-body {
  min-width: 0;
}

.courier-name {
  display: block;
  color: #302923;
  font-size: 31rpx;
  font-weight: 900;
}

.delivery-note {
  display: block;
  margin-top: 10rpx;
  color: #cc5d66;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.4;
}

.delivery-desc {
  display: block;
  margin-top: 16rpx;
}

.actions {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.two-actions {
  grid-template-columns: 1fr 1fr;
}

.two-actions button,
.empty-action {
  margin: 0;
  min-height: 82rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.empty-action {
  margin-top: 22rpx;
}

.refund-panel {
  gap: 18rpx;
}

.refund-toggle {
  margin-top: 4rpx;
}

.refund-form {
  display: grid;
  gap: 18rpx;
  padding-top: 8rpx;
}

.refund-list {
  display: grid;
  gap: 14rpx;
}

.refund-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fffefb;
}

.refund-title {
  display: block;
  color: #302923;
  font-size: 28rpx;
  font-weight: 900;
}

.refund-status {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8d493d;
  background: #fff2ee;
  font-size: 23rpx;
  font-weight: 900;
}
