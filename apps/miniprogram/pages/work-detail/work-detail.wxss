.work-detail-page {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-bottom: 42rpx;
}

.share-hero {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(117, 81, 63, 0.12);
  border-radius: 28rpx;
  background: #fffefb;
  box-shadow: 0 20rpx 54rpx rgba(109, 69, 54, 0.12);
}

.hero-image {
  display: block;
  width: 100%;
  height: 520rpx;
  background: #efe7dd;
}

.hero-copy {
  min-width: 0;
  box-sizing: border-box;
  padding: 26rpx;
  color: #302923;
  background: linear-gradient(135deg, #fffefb 0%, #fff2ec 100%);
}

.hero-copy .title,
.hero-copy .eyebrow {
  color: #302923;
}

.hero-copy .muted {
  display: block;
  margin-top: 12rpx;
  color: #6f6158;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.stat-pill {
  min-width: 0;
  box-sizing: border-box;
  min-height: 92rpx;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  background: #fffefb;
  border: 1rpx solid rgba(94, 73, 53, 0.08);
  text-align: center;
}

.stat-pill text:first-child {
  display: block;
  color: #302923;
  font-size: 28rpx;
  font-weight: 900;
}

.stat-pill text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #8a7466;
  font-size: 22rpx;
}

.work-prompt {
  display: block;
  color: #3c302b;
  font-size: 28rpx;
  line-height: 1.55;
}

.action-grid {
  display: grid;
  min-width: 0;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.mini-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 76rpx;
  margin: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #302923;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.2;
}

.rose-button {
  background: #cc5d66;
}

.share-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.action-stack {
  display: grid;
  min-width: 0;
  gap: 14rpx;
}

.panel-lead {
  display: block;
  margin: 8rpx 0 16rpx;
}

.detail-loop {
  display: grid;
  min-width: 0;
  gap: 10rpx;
}

.detail-loop-step {
  display: flex;
  min-width: 0;
  box-sizing: border-box;
  gap: 12rpx;
  align-items: flex-start;
  padding: 14rpx;
  border-radius: 14rpx;
  color: #4e423a;
  background: #f4fbf6;
  font-size: 22rpx;
  line-height: 1.4;
}

.detail-loop-index {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #2f6f5f;
  font-size: 19rpx;
  font-weight: 900;
}

.review-item,
.tip-list text {
  min-width: 0;
  box-sizing: border-box;
}

.review-list,
.tip-list {
  display: grid;
  gap: 12rpx;
}

.review-item,
.tip-list text {
  display: block;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f4fbf6;
  font-size: 25rpx;
  line-height: 1.45;
}

.bot-name {
  display: block;
  margin-bottom: 8rpx;
  color: #2f6f5f;
  font-size: 26rpx;
  font-weight: 900;
}

.review-focus {
  display: block;
  margin-bottom: 6rpx;
  color: #b94e58;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-detail {
  margin-top: 40rpx;
}
