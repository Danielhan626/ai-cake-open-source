.result-image {
  margin: 24rpx 0;
}

.result-tabs {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  gap: 10rpx;
  margin: 0 0 18rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fffefb;
  box-shadow: 0 10rpx 24rpx rgba(80, 51, 30, 0.08);
}

.result-tab,
.result-tabs button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 64rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 12rpx;
  color: #6f6258;
  background: transparent;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
  white-space: normal;
}

.result-tab.active,
.result-tabs button.active {
  color: #ffffff;
  background: #302923;
}

.action-stack {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
}

.refine-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(94, 73, 53, 0.1);
}

.small-title {
  font-size: 27rpx;
}

.ai-section {
  margin-top: 28rpx;
}

.game-result {
  background: #fffefb;
}

.game-score {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 20rpx;
}

.score-number {
  display: block;
  color: #cc5d66;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
}

.score-label {
  display: block;
  margin-top: 6rpx;
  color: #71685f;
  font-size: 24rpx;
}

.score-badge {
  display: inline-flex;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #2f7c67;
  font-size: 26rpx;
  font-weight: 800;
}

.game-challenge {
  display: block;
  margin-top: 10rpx;
  text-align: right;
}

.reward-box {
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff2ee;
}

.reward-amount {
  display: block;
  margin-bottom: 6rpx;
  color: #cc5d66;
  font-size: 30rpx;
  font-weight: 900;
}

.review-list {
  display: grid;
  min-width: 0;
  gap: 14rpx;
}

.review-card {
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f4fbf6;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review-seat-copy {
  display: grid;
  gap: 6rpx;
}

.review-name {
  display: block;
  color: #2f6f5f;
  font-size: 27rpx;
  font-weight: 900;
}

.review-likes {
  flex: 0 0 auto;
  max-width: 190rpx;
  color: #7a6f65;
  font-size: 23rpx;
}

.review-focus {
  display: block;
  color: #b94e58;
  font-size: 23rpx;
  line-height: 1.4;
}

.review-line {
  display: block;
  max-width: 100%;
  margin-top: 8rpx;
  color: #5c655f;
  font-size: 25rpx;
  line-height: 1.45;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-like {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  max-width: 100%;
  box-sizing: border-box;
  min-height: 60rpx;
  margin: 14rpx 0 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: #2f6f5f;
  background: #edf8f2;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
  white-space: normal;
}

.review-like.liked {
  color: #ffffff;
  background: #2f7c67;
}

.review-summary-card {
  display: grid;
  gap: 14rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fffefb;
}

.review-summary-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 64rpx;
  margin: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.review-more-hint {
  display: block;
  margin-top: 14rpx;
}

.interaction-grid {
  display: grid;
  min-width: 0;
  max-width: 100%;
  gap: 12rpx;
}

.interaction-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  min-height: 104rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fffefb;
  text-align: left;
}

.interaction-value {
  display: block;
  color: #302923;
  font-size: 42rpx;
  font-weight: 940;
  line-height: 1.1;
}

.interaction-label {
  display: block;
  margin-top: 4rpx;
  color: #7a6f65;
  font-size: 24rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 62rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #302923;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
  white-space: normal;
}

.feedback-loop {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin: 0 0 16rpx;
}

.feedback-loop text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #2f6f5f;
  background: #edf8f2;
  text-align: center;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1.15;
}

.feedback-summary {
  display: grid;
  gap: 6rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff7f3;
}

.feedback-summary-title {
  color: #302923;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.audience-foot {
  display: grid;
  gap: 12rpx;
  margin-top: 14rpx;
}

.audience-foot-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 68rpx;
  margin: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.rose-action {
  background: #cc5d66;
}

.rose-balance {
  display: block;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  gap: 16rpx;
}

.same-style-confirm-card,
.demand-field-stack {
  display: grid;
  gap: 16rpx;
}

.same-style-title {
  display: block;
  color: #302923;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.confirm-state {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b94e58;
  background: #fff0ec;
  font-size: 22rpx;
  font-weight: 900;
}

.confirm-state.active {
  color: #2f6f5f;
  background: #edf8f2;
}

.production-notice-list {
  display: grid;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff7f3;
}

.production-notice-list text {
  display: block;
  color: #6b5147;
  font-size: 23rpx;
  line-height: 1.45;
}

.confirm-notice-button {
  margin: 0;
}

.same-style-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.same-style-summary view {
  min-width: 0;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #fffefb;
}

.same-style-summary text:first-child {
  display: block;
  color: #8a7466;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.2;
}

.same-style-summary text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #302923;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow-wrap: break-word;
}

.small-textarea {
  min-height: 110rpx;
}

.detail-toggle {
  min-height: 72rpx;
  margin: 0;
  font-size: 25rpx;
  box-shadow: none;
}

.detail-fields {
  display: grid;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fffaf5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 82rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 4rpx 0 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  color: #4b4139;
  background: #fffefb;
  font-size: 27rpx;
}

.switch-pill {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b94e58;
  background: #fff0ec;
  font-size: 24rpx;
  font-weight: 900;
}

.switch-pill.active {
  color: #2f6f5f;
  background: #edf8f2;
}

.refine-panel {
  display: block;
}

.refine-textarea {
  margin-top: 18rpx;
}

.refine-action {
  margin-top: 18rpx;
}

.credit-strip {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fffefb;
}

.credit-copy {
  display: grid;
  gap: 8rpx;
}

.credit-balance {
  color: #2f6f5f;
  font-size: 30rpx;
  font-weight: 900;
}

.credit-strip-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  gap: 12rpx;
}

.compact-credit-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 74rpx;
  margin: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.recharge-panel {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff7f3;
}

.recharge-close {
  width: 110rpx;
  min-height: 58rpx;
  margin: 0;
}

.recharge-grid {
  display: grid;
  gap: 12rpx;
}

.recharge-card {
  display: grid;
  gap: 6rpx;
  width: 100%;
  min-height: 0;
  margin: 0;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid rgba(94, 73, 53, 0.1);
  border-radius: 16rpx;
  background: #fffefb;
}

.recharge-card.active {
  border-color: rgba(47, 124, 103, 0.4);
  background: #edf8f2;
}

.recharge-credits {
  color: #302923;
  font-size: 30rpx;
  font-weight: 900;
}

.recharge-amount {
  color: #cc5d66;
  font-size: 26rpx;
  font-weight: 900;
}

.recharge-note {
  display: block;
}

.share-button,
.empty-action {
  margin-top: 18rpx;
}
