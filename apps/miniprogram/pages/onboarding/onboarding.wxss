.onboarding-page {
  padding-bottom: 42rpx;
}

.onboarding-hero {
  padding: 34rpx 28rpx 28rpx;
  border: 1rpx solid rgba(117, 81, 63, 0.12);
  border-radius: 28rpx;
  color: #302923;
  background:
    radial-gradient(circle at 86% 12%, rgba(159, 215, 190, 0.24), transparent 28%),
    linear-gradient(135deg, #fffefb 0%, #fff2ec 52%, #edf8f2 100%);
  box-shadow: 0 20rpx 54rpx rgba(109, 69, 54, 0.12);
  margin-bottom: 24rpx;
}

.onboarding-hero .title,
.onboarding-hero .eyebrow {
  color: #302923;
}

.onboarding-hero .muted {
  display: block;
  margin-top: 14rpx;
  color: #6f6158;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.link-button {
  flex: 0 0 auto;
  width: 164rpx;
  min-height: 64rpx;
  margin: 0;
  border-radius: 999rpx;
  color: #2f6f5f;
  background: #edf8f2;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.status-pill {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #cc5d66;
  font-size: 26rpx;
  font-weight: 900;
}

.status-copy {
  display: block;
  margin-top: 16rpx;
}

.submit-button {
  margin-top: 18rpx;
}

.upload-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 10rpx;
}

.upload-button {
  width: 100%;
  min-height: 68rpx;
  margin: 0;
  border-radius: 14rpx;
  color: #2f6f5f;
  background: #edf8f2;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.upload-url {
  display: block;
  max-width: 100%;
  color: #8a7466;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}
