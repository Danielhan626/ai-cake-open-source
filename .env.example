# API
PORT=4000
APP_ORIGIN=http://localhost:5173
APP_RELEASE_ID=local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INCLUDE_SEED_BAKERS_IN_PUBLIC=0
LOCATION_MODE=optional_auto_city

# AI provider: mock | aliyun | volcengine | relay
AI_PROVIDER=mock
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_TEXT_IMAGE_MODEL=qwen-image-2.0
ALIYUN_IMAGE_EDIT_MODEL=qwen-image-edit-max
ALIYUN_IMAGE_SIZE=2048*2048
ALIYUN_IMAGE_EDIT_SIZE=1328*1328
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
IMAGE_RELAY_API_KEY=
IMAGE_RELAY_BASE_URL=
IMAGE_RELAY_MODEL=gpt-image-1
AI_IMAGE_SIZE=1024x1024

# AI Bot text provider for design tasks/reviews: mock | doubao | deepseek
BOT_LLM_PROVIDER=mock
# Optional override for AI comment seats. Empty means use BOT_LLM_PROVIDER.
BOT_REVIEW_PROVIDER=
BOT_LLM_BASE_URL=
BOT_LLM_API_KEY=
BOT_LLM_MODEL=
BOT_LLM_TIMEOUT_MS=12000

# Payment provider: mock | wechat
PAY_PROVIDER=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=mock_mch_id
WECHAT_PAY_NOTIFY_URL=http://localhost:4000/payments/wechat/notify
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PEM=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PEM=
WECHAT_PAY_PLATFORM_CERTIFICATE_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERTIFICATE_PEM=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
